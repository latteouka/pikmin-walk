<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Pikmin Walker — tunneld LaunchDaemon template.

  Substituted at install time by scripts/install.sh:
    __PROJECT_DIR__   absolute path to the cloned repo
    __USER_HOME__     $HOME of the administering user (so tunneld can
                      find the user-installed pymobiledevice3 binary)
    __ADMIN_USER__    administering user's login (for log ownership)

  This runs as root (utun creation needs root) but the wrapper script
  pins the binary to the admin user's uv-installed pymobiledevice3 so
  versions stay consistent with the LaunchAgent.

  Same KeepAlive / Throttle / ExitTimeOut policy as the LaunchAgent.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pikmin.tunneld</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_DIR__/scripts/launchd/tunneld-wrapper.sh</string>
    </array>

    <key>UserName</key>
    <string>root</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ExitTimeOut</key>
    <integer>15</integer>

    <key>StandardOutPath</key>
    <string>/var/log/pikmin-tunneld.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/pikmin-tunneld.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__USER_HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PIKMIN_ADMIN_USER</key>
        <string>__ADMIN_USER__</string>
        <key>PIKMIN_ADMIN_HOME</key>
        <string>__USER_HOME__</string>
    </dict>
</dict>
</plist>
